OPENAI_API_KEY=
# Web search (Serper, google.serper.dev). Blank disables web search.
SERPER_API_KEY=
DATABASE_URL=postgresql://nba:nba@localhost:5432/nba
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
NEXT_PUBLIC_API_URL=http://localhost:8200
APP_ENV=dev
# Optional: when set, run endpoints require Authorization: Bearer <APP_TOKEN>. Leave blank for open demo mode.
APP_TOKEN=
# Auth: HS256 secret for the nba_session JWT cookie. Override in any real deployment.
JWT_SECRET=
# Public base URL of the frontend, used to build email verification links.
APP_BASE_URL=http://localhost:3200
# Comma-separated emails allowed into the admin panel (/admin).
ADMIN_EMAILS=
# AWS SES (email verification). Leave blank offline: signup auto-verifies and logs the link.
AWS_REGION=us-east-1
SES_SENDER_EMAIL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Google OAuth (Gmail send connector). Leave blank offline: the consent flow
# reports a graceful "not configured" status and never crashes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3200/api/auth/callback/google
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- CORS ---------------------------------------------------------------------
# Exact local origins (comma separated). The regex below additionally allows any
# niheshr.com subdomain, so production needs no change here.
CORS_ORIGINS=http://localhost:3200
CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)*niheshr\.com
# Share the session cookie across subdomains. Blank = host-only (local dev).
COOKIE_DOMAIN=

# --- Production (aperture.niheshr.com + aperture-api.niheshr.com) --------------
# Set these for the deploy; CORS already allows *.niheshr.com via the regex above.
#   APP_ENV=production
#   NEXT_PUBLIC_API_URL=https://aperture-api.niheshr.com
#   APP_BASE_URL=https://aperture.niheshr.com
#   GOOGLE_REDIRECT_URI=https://aperture.niheshr.com/api/auth/callback/google
#   COOKIE_DOMAIN=.niheshr.com   # shares the login cookie across both subdomains
