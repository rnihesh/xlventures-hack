FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

# Copy manifests first for better layer caching (build context is ./frontend)
COPY package.json package-lock.json* ./

RUN npm ci

# Copy the rest of the frontend source
COPY . /app

RUN npm run build

EXPOSE 3000

CMD ["npm", "start"]
