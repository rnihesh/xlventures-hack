FROM node:20-alpine

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so the
# API URL must be present during `npm run build` (not just at runtime).
ARG NEXT_PUBLIC_API_URL=http://localhost:8200
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# Copy manifests first for better layer caching (build context is ./frontend).
COPY package.json package-lock.json* ./

# Install ALL dependencies (including devDependencies such as typescript and
# tailwindcss) which `next build` needs. NODE_ENV is intentionally left unset
# here so npm does not skip devDependencies.
RUN npm ci

# Copy the rest of the frontend source and build.
COPY . /app
RUN npm run build

# Production runtime for `next start`.
ENV NODE_ENV=production

EXPOSE 3200

CMD ["npm", "start"]
