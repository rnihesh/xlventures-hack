FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

# Install system build dependencies (asyncpg builds, healthcheck curl).
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/*

# Bring in the uv binary from the official image (pinned for reproducible builds).
COPY --from=ghcr.io/astral-sh/uv:0.11.17 /uv /uvx /bin/

# Install dependencies first (cached layer) using the lockfile. Build context is
# ./backend, so pyproject.toml, uv.lock, and the README it references are present.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-install-project --no-dev

# Copy the rest of the source and install the project itself.
COPY . /app
RUN uv sync --frozen --no-dev

EXPOSE 8000

# Run inside the uv-managed environment.
CMD ["uv", "run", "--no-dev", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
