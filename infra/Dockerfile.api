FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install system build dependencies (psycopg/asyncpg builds, healthcheck curl).
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/*

# Copy backend source (build context is ./backend).
COPY . /app

# Install the project and its dependencies via pip. The pyproject uses the
# hatchling build backend, so an editable install resolves everything declared
# under [project].dependencies (fastapi, uvicorn, alembic, ...).
RUN pip install --upgrade pip \
    && pip install -e .

EXPOSE 8000

# Run the FastAPI app directly with uvicorn (deps are on the system interpreter).
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
